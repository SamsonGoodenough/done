# Copied to .env (gitignored) for local docker compose runs.
# Values here are used by compose.yml for container ports and the
# postgres service; the Laravel app itself reads backend/.env.

COMPOSE_PROJECT_NAME=done

POSTGRES_DB=done
POSTGRES_USER=done
POSTGRES_PASSWORD=changeme

NGINX_PORT=8080
FRONTEND_PORT=5173
MAILHOG_WEB_PORT=8025
